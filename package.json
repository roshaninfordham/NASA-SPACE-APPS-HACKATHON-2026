{
  "name": "komaku-dust-and-radiation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "game:import": "godot --headless --path game --editor --import",
    "game:run": "godot --path game",
    "game:test": "python3 scripts/test_game.py",
    "game:build": "python3 scripts/build_game.py",
    "test:pwa": "playwright test --config playwright.web.config.js"
  },
  "dependencies": {
    "three": "0.181.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "vite": "7.2.2"
  }
}
