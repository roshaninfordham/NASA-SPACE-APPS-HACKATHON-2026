extends SceneTree
## End-to-end shell semantics: review is acknowledged, not inferred mastery.
const Shell = preload("res://ui/journey_shell.gd")
const Mission = preload("res://scripts/pace_mission.gd")
var failures := 0
var assertions := 0
var source_events: Array[String] = []
var quiz_events: Array = []
var home_events := 0
var ready_events := 0
var live_sun_events := 0
func _initialize() -> void: call_deferred("run")
func check(condition: bool, label: String) -> void:
	assertions += 1
	if condition: print("PASS: ", label)
	else:
		failures += 1
		push_error(label)
func frames(count := 6) -> void:
	for index in range(count): await process_frame
func key(code: Key) -> void:
	for pressed in [true, false]:
		var event := InputEventKey.new()
		event.keycode = code
		event.physical_keycode = code
		event.pressed = pressed
		root.push_input(event)
	await frames()
func button_target(button: Button, label: String) -> void:
	check(Rect2(Vector2.ZERO, root.get_visible_rect().size).grow(1).encloses(button.get_global_rect()), label + " remains inside viewport")
	check(button.size.x >= 44 and button.size.y >= 44, label + " has a readable physical target")
func run() -> void:
	root.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
	var catalog: Array = JSON.parse_string(FileAccess.get_file_as_string("res://data/mission-concepts.json")).concepts
	check(catalog.size() == 8, "Eight real source-backed concept entries exist")
	var shell := Shell.new()
	shell.catalog = catalog.duplicate(true)
	root.add_child(shell)
	shell.ready_requested.connect(func(): ready_events += 1)
	shell.home_requested.connect(func(): home_events += 1)
	shell.source_requested.connect(func(url): source_events.append(url))
	shell.live_data_requested.connect(func(): live_sun_events += 1)
	shell.quiz_answered.connect(func(record): quiz_events.append(record))
	await frames()
	shell.set_process(false)
	shell.show_story(false)
	await frames()
	check(shell._story_index == 0 and shell._story_words.visible_characters == 0, "Story begins at2059 with actual incomplete typewriter text")
	shell.advance_story()
	check(shell._story_index == 0 and shell._story_words.visible_characters == -1, "First advance reveals text without skipping the beat")
	shell.advance_story()
	check(shell._story_index == 1, "Second advance reaches the next story beat")
	shell.set_reduced_motion(true)
	check(shell._story_words.visible_characters == -1, "Reduced motion reveals the complete current story immediately")
	shell._story_skip.pressed.emit()
	await frames()
	check(shell.state == "preparation" and shell.readiness == 0, "Skip intro reaches real preparation without inventing reviewed topics")
	check(not shell._ready_button.disabled and shell._ready_button.text == "Enter control room", "Optional concepts never block entering the control room")
	shell._live_sun_button.pressed.emit()
	check(live_sun_events == 1 and shell.state == "preparation" and shell.readiness == 0, "Preparation Live Sun requests the host panel without changing review or mission state")
	shell._request_ready()
	check(ready_events == 1, "Control room remains reachable with zero concepts reviewed")
	shell._orbs[0].grab_focus()
	await key(KEY_ENTER)
	check(shell.concept_open, "Keyboard activates the first concept orb")
	shell._request_ready()
	check(ready_events == 1 and shell._ready_button.disabled, "An open reading card keeps the underlying Enter action inactive")
	for index in range(6):
		await key(KEY_TAB)
		check(shell._dialog.is_ancestor_of(root.gui_get_focus_owner()), "Concept modal keeps Tab navigation inside the reading card")
	var first_id := str(catalog[0].id)
	var source: Button
	for control in shell._dialog.find_children("*", "Button", true, false):
		if "↗" in control.text: source = control
	check(source != null, "Concept has an explicit source action")
	if source: source.pressed.emit()
	var card_live_sun := shell._dialog.find_child("RadiationLiveSun", true, false) as Button
	check(card_live_sun != null, "Radiation card offers a discoverable Live Sun action beside its source")
	if card_live_sun: card_live_sun.pressed.emit()
	check(live_sun_events == 2 and shell.concept_open and shell.reviewed_ids.is_empty(), "Live Sun action preserves the open radiation card without acknowledging it")
	check(source_events.size() == 1 and source_events[0] == str(catalog[0].source_url), "Source click emits the exact approved URL instead of opening a browser internally")
	await key(KEY_ESCAPE)
	check(not shell.concept_open and shell.reviewed_ids.is_empty(), "Escape abandons a card without falsely recording review")
	check(root.gui_get_focus_owner() == shell._orbs[0], "Closing a concept restores the activating orb's keyboard focus")
	shell.open_concept(first_id)
	shell._dialog_done.grab_focus()
	await key(KEY_ENTER)
	check(not shell.concept_open and shell.reviewed_ids.size() == 1 and is_equal_approx(shell.readiness, 0.125), "Explicit acknowledgement completes exactly one of eight concepts")
	shell.open_concept(first_id)
	shell.close_concept()
	check(shell.reviewed_ids.size() == 1, "Reopening a concept cannot inflate readiness")
	shell.show_preparation(catalog, shell.reviewed_ids)
	check(shell.reviewed_ids.size() == 1, "Passing the current review array does not erase it through aliasing")
	for concept: Dictionary in catalog:
		shell.open_concept(str(concept.id))
		check(shell._dialog.find_child("ConceptDiagram", true, false).concept_id == str(concept.id), "Each concept has its own qualitative teaching diagram")
		shell.close_concept()
	await frames()
	check(shell.reviewed_ids.size() == 8 and shell.readiness == 1.0 and not shell._ready_button.disabled, "Exploring all eight records progress without turning it into a prerequisite")
	shell._ready_button.pressed.emit()
	check(ready_events == 2, "Enter control room also works after all concepts are explored")
	var reviewed_before := shell.reviewed_ids.duplicate()
	var mission := Mission.new()
	mission.advance(60)
	var snapshot := mission.snapshot()
	var snapshot_before := snapshot.duplicate(true)
	shell.hide()
	shell.show_live_concept("dose", snapshot)
	await frames()
	check(shell.visible and shell.state == "live" and shell.concept_open and not shell._body.visible, "Live concept uses a transparent shell with only its reading card")
	check(shell._live_readout("dose").contains("%.2f" % float(snapshot.dose_ugy)), "Live explanation includes the actual run's current dose")
	shell.close_concept()
	check(not shell.visible and not shell.concept_open and shell.reviewed_ids == reviewed_before, "Closing a live card hides the shell and preserves preparation progress")
	check(snapshot == snapshot_before, "Reading and closing never mutate the caller's mission snapshot")
	shell.show_live_concept("power", snapshot)
	var energy_readout: String = shell._live_readout("power")
	check(energy_readout.contains("Stored now: %.3f kWh" % float(snapshot.battery_kwh)) and not energy_readout.contains("forecast"), "Live energy card shows actual storage without an obsolete forecast")
	check(energy_readout.contains("%.2f kW" % float(snapshot.solar_power_kw)) and energy_readout.contains("capacity"), "Live energy card distinguishes current power from accumulated capacity-limited energy")
	shell.close_live_concept()
	mission.advance(240)
	var result := mission.result()
	check(result.status == "win", "Debrief fixture is an actual successful model run")
	shell.set_reduced_motion(true)
	shell.show_debrief(result, catalog)
	await frames()
	check(shell._merge_done and shell._scroll.visible and not shell._merge_skip.visible, "Reduced-motion debrief exposes content without waiting for animation")
	check(shell.quiz_first_answer == -1 and not shell.quiz_record().answered, "Optional unanswered transfer question is not recorded as wrong")
	shell.answer_quiz(1)
	check(shell.quiz_first_answer == 1 and quiz_events.size() == 1 and not quiz_events[0].correct, "First transfer answer is recorded before feedback")
	shell.answer_quiz(0)
	check(shell.quiz_first_answer == 1 and quiz_events.size() == 1 and "tiredness" in shell._debrief_quiz_feedback.text, "Practice retries explain the answer without rewriting first evidence")
	check(shell._debrief_charts.get_child(0).samples == result.history, "Graphs use the actual run history rather than fabricated samples")
	check(shell._cleaning_work_equation() == "0.125 × 30.000 effective minutes = 3.75 sections", "Work equation uses the integrated fatigue-weighted active time")
	check(shell._dose_equation().contains("1800²") and shell._dose_equation().ends_with("10.9375 µGy"), "Dose equation integrates the authored rising rate instead of using a constant final rate")
	check(shell.quiz_record().question_id == "pace-fatigue-transfer-1", "New fatigue transfer evidence has its own question identity")
	check(shell._solar_equation() == "8.00 kW × 0.953 transmission = 7.62 kW now", "Solar equation uses actual dust transmission and power")
	check(shell._energy_equation() == "0.500 initial + 2.406 generated − 0.500 supplied = 2.406 kWh stored", "Energy equation balances the actual full-duration run")
	check(shell._debrief_charts.get_child(0).channel == "battery_kwh" and shell._debrief_charts.get_child(0).unit == "kWh", "First chart plots actual battery energy")
	check(is_equal_approx(float(shell._debrief_charts.get_child(0).samples.back().battery_kwh),float(result.battery_kwh)), "Battery graph ends at actual mission-end storage")
	check(shell._outcome_heading().begins_with("WIN"), "Mostly-clean outcome is labeled WIN")
	var fast := Mission.new()
	fast.set_cleaning_speed(1.75)
	fast.advance(300)
	shell.show_debrief(fast.result(),catalog)
	check(fast.result().status == "pass" and shell._outcome_heading().begins_with("PASS"), "Fast, tiring full run gets its actual PASS result")
	check(shell._fatigue_equation().ends_with("final F = 0.900") and shell._rate_equation().contains("(1 − 0.900)"), "Debrief connects final tiredness to the reduced effective rate")
	var slow := Mission.new()
	slow.set_cleaning_speed(0.25)
	slow.advance(300)
	shell.show_debrief(slow.result(),catalog)
	check(slow.result().status == "lose" and shell._outcome_heading().begins_with("LOSE"), "Mostly-dusty full run gets its actual LOSE result")
	check(is_equal_approx(fast.result().dose_ugy,result.dose_ugy) and is_equal_approx(slow.result().dose_ugy,result.dose_ugy), "Different pace outcomes do not invent different full-round doses or bonus stars")
	var mixed := Mission.new()
	mixed.set_cleaning_speed(1.75)
	mixed.advance(60)
	mixed.set_cleaning_speed(0.5)
	mixed.advance(60)
	shell._result = mixed.result()
	check(is_equal_approx(float(mixed.result().cleaned_work),1.38375) and shell._cleaning_work_equation().contains("11.070 effective minutes"), "Actual mixed fatigue/recovery history is integrated rather than applying the final pace retroactively")
	shell._result = result.duplicate(true)
	var capped := Mission.new({"battery_capacity_kwh": 0.55, "habitat_load_kw": 0.0})
	capped.advance(20)
	shell._result = capped.result()
	check(shell._energy_equation().contains("overflow") and shell._energy_equation().ends_with("0.550 kWh stored"), "Capacity-limited equation accounts for rejected solar energy")
	var empty := Mission.new({"clear_solar_power_kw": 0.0, "initial_battery_kwh": 0.0})
	empty.advance(20)
	shell._result = empty.result()
	check(shell._energy_equation().contains("0.000 supplied") and shell._energy_equation().ends_with("0.000 kWh stored"), "Empty-battery equation does not pretend unmet demand was supplied")
	shell._result = result.duplicate(true)
	for dimensions in [Vector2i(1280,720), Vector2i(960,540), Vector2i(390,844), Vector2i(844,390)]:
		root.size = dimensions
		shell.show_story(true)
		await frames(12)
		button_target(shell._story_next, "Story continue " + str(dimensions))
		button_target(shell._story_skip, "Story skip " + str(dimensions))
		button_target(shell._settings, "Settings " + str(dimensions))
		shell.advance_story()
		shell.advance_story()
		await frames()
		check(shell._story_words.global_position.y >= shell._story_head.get_global_rect().end.y, "Long story heading stays clear of body copy " + str(dimensions))
		shell.show_preparation(catalog)
		await frames(12)
		button_target(shell._ready_button, "Ready " + str(dimensions))
		button_target(shell._live_sun_button, "Live Sun " + str(dimensions))
		check(not shell._live_sun_button.get_global_rect().intersects(shell._ready_button.get_global_rect()), "Live Sun never obscures Ready " + str(dimensions))
		check(not shell._live_sun_button.get_global_rect().intersects(shell._scroll.get_global_rect()), "Live Sun stays separate from constellation interaction " + str(dimensions))
		check(not shell._live_sun_button.get_global_rect().intersects(shell._title.get_global_rect()), "Live Sun does not overlap the preparation heading " + str(dimensions))
		if shell._subtitle.visible:
			check(not shell._live_sun_button.get_global_rect().intersects(shell._subtitle.get_global_rect()), "Live Sun does not overlap preparation instructions " + str(dimensions))
		check(shell._progress_label.get_global_rect().end.x < shell._ready_button.global_position.x, "Review explanation stays beside Ready " + str(dimensions))
		check(shell._title.size.x <= shell._body.size.x, "Preparation title wraps within viewport " + str(dimensions))
		check(shell._scroll.get_global_rect().end.y <= shell._footer.global_position.y, "Preparation content keeps the launch footer clear " + str(dimensions))
		for orb in shell._orbs:
			check(orb.size.x >= 80 and orb.size.y >= 104, "Concept targets retain physical size " + str(dimensions))
		shell.open_concept("radiation")
		await frames(12)
		check(Rect2(Vector2.ZERO, root.get_visible_rect().size).grow(1).encloses(shell._dialog.get_global_rect()), "Reading card stays within viewport " + str(dimensions))
		button_target(shell._dialog_done, "Concept close " + str(dimensions))
		shell._dialog_extra.show()
		await frames()
		button_target(shell._dialog_done, "Expanded science close " + str(dimensions))
		check(shell._dialog_scroll.size.y > 0, "Expanded evidence remains scrollable " + str(dimensions))
		shell.close_concept()
		shell.show_debrief(result, catalog)
		await frames(12)
		button_target(shell._footer.get_node("Retry"), "Debrief retry " + str(dimensions))
		button_target(shell._footer.get_node("Finish"), "Debrief finish " + str(dimensions))
		check(shell._scroll.get_global_rect().end.y <= shell._footer.global_position.y, "Debrief scroll preserves a reachable finish " + str(dimensions))
		check(shell._subtitle.size.x <= shell._body.size.x, "Debrief subtitle wraps within viewport " + str(dimensions))
		check(shell._scroll.get_global_rect().end.x <= dimensions.x - 19, "Debrief scroll does not extend beyond viewport " + str(dimensions))
		check(shell._debrief_content.size.x <= shell._scroll.size.x, "Debrief content fits available reading width " + str(dimensions))
		check(shell._scroll.scroll_vertical == 0, "Debrief begins at actual run summary " + str(dimensions))
		var charts := shell._debrief_charts
		check(charts.columns == (1 if dimensions.x < 720 else 2), "Graph layout adapts without scaling text " + str(dimensions))
	shell.show_preparation([])
	check(shell.readiness == 0 and not shell._ready_button.disabled, "Missing concepts do not invent progress or block the control room")
	shell.handle_back()
	check(home_events == 1, "Home remains an explicit escape from incomplete preparation")
	shell.catalog = catalog.duplicate(true)
	shell.show_story(true)
	var next_screen: Callable = func(): shell.hide()
	shell.story_finished.connect(next_screen)
	shell._story_skip.pressed.emit()
	await frames()
	check(not shell.visible and shell.state == "story", "A host-controlled story transition cannot be overridden by the standalone science-library fallback")
	shell.story_finished.disconnect(next_screen)
	shell.queue_free()
	await frames()
	print("JOURNEY SHELL ASSERTIONS: ", assertions, " FAILURES: ", failures)
	quit(1 if failures else 0)
