extends SceneTree
var failures := 0
func check(condition: bool, message: String) -> void:
	if condition: print("PASS: ", message)
	else:
		push_error(message)
		failures += 1
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var player = load("res://scripts/player.gd").new()
	root.add_child(player)
	player.set_physics_process(false)
	player.position = Vector3(20, 2, 14)
	player.velocity = Vector3(3, 1, 2)
	player._keep_inside_training_area()
	check(player.position == Vector3(20,2,14) and player.velocity == Vector3(3,1,2) and not player.at_training_boundary, "Ordinary movement/jump state is unchanged")
	player.position = Vector3(57,2,0)
	player._keep_inside_training_area()
	check(player.at_training_boundary and player.position.x == 57, "Training boundary warns before stopping movement")
	player.position = Vector3(65,2,0)
	player.velocity = Vector3(5,1,3)
	player._keep_inside_training_area()
	check(is_equal_approx(player.position.x,62) and player.position.z == 0 and player.position.y == 2, "Outer edge stops nearby rather than teleporting to spawn")
	check(player.velocity == Vector3(0,1,3), "Outward travel stops; tangential motion and vertical physics remain")
	player.position = Vector3(55,2,55)
	player.velocity = Vector3(-2,0,-2)
	player._keep_inside_training_area()
	check(is_equal_approx(Vector2(player.position.x,player.position.z).length(),62) and player.position.x > 40, "Diagonal travel stays inside the circular playable area")
	check(player.velocity == Vector3(-2,0,-2), "Returning toward the outpost is never blocked")
	player.position = Vector3(1,-6,1)
	player._keep_inside_training_area()
	check(player.position == Vector3(0,0.3,14) and player.velocity == Vector3.ZERO, "Unexpected floor escape recovers to known safe spawn")
	var scanner = player.camera.get_child(0)
	var scanner_was_visible: bool = scanner.visible
	player.configure_operator_area(true)
	check(not scanner.visible, "Indoor operator has a clear window view without handheld EVA scanner")
	player.position = Vector3(1, 1, -13)
	player.velocity = Vector3(1, 2, 1)
	player._keep_inside_training_area()
	check(player.position == Vector3(1,1,-13) and player.velocity == Vector3(1,2,1) and not player.at_training_boundary, "Indoor ordinary movement and vertical physics are unchanged")
	player.position = Vector3(4, 1, -10)
	player.velocity = Vector3(2, 1, 2)
	player._keep_inside_training_area()
	check(player.position == Vector3(3,1,-11.2) and player.velocity == Vector3(0,1,0) and player.at_training_boundary, "Indoor front corner stops outward travel without moving to EVA spawn")
	player.position = Vector3(-4, 1, -17)
	player.velocity = Vector3(2, 1, 2)
	player._keep_inside_training_area()
	check(player.position == Vector3(-3,1,-16) and player.velocity == Vector3(2,1,2), "Indoor rear corner preserves inward travel")
	player.position.y = -6
	player._keep_inside_training_area()
	check(player.position == Vector3(0,0.3,-12.6), "Indoor floor recovery remains inside the control room")
	player.configure_operator_area(false)
	check(scanner.visible == scanner_was_visible and not player.operator_area, "EVA mode restores scanner presentation and outdoor movement bounds")
	player.queue_free()
	await process_frame
	print("PLAY AREA FAILURES: ", failures)
	quit(1 if failures else 0)
