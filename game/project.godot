config_version=5

[application]
config/custom_user_dir_name.linux="godot/app_userdata/Red Veil"
config/custom_user_dir_name="Godot/app_userdata/Red Veil"
config/use_custom_user_dir=true
config/name="KŌMAKU: Shield Protocol"
config/version="0.6.1-alpha.1"
config/description="KŌMAKU: Shield Protocol — a first-person Mars learning adventure for young explorers."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]
Updates="*res://updater/bootstrap.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=1024

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=3.71

[audio]
driver/enable_input=false
